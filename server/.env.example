# ==========================================
# Database Configuration (Supabase Managed PostgreSQL)
# ==========================================
# The app connects directly to Supabase via its pooler or direct connection string:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
FALLBACK_IN_MEMORY=True

# ==========================================
# Supabase Integration
# ==========================================
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_PASSWORD=your_db_password_here
SUPABASE_POOLER_HOST=aws-0-eu-central-1.pooler.supabase.com
SUPABASE_POOLER_PORT=6543

# ==========================================
# Sports Data API Integration (SportAPI.ai key)
# ==========================================
FOOTBALL_API_KEY=your_sportapi_api_key_here
FOOTBALL_API_PROVIDER=sportapi
FINNHUB_API_KEY=your_finnhub_api_key_here

# ==========================================
# Supabase Integration
# ==========================================
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_PASSWORD=your_db_password_here
# Direct PostgreSQL Connection String for Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres


